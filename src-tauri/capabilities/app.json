{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app",
  "description": "The app's own windows (the main window and the tray panel): the app's commands and its events, nothing else of the system",
  "windows": ["main", "tray"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-app-commands"
  ]
}
