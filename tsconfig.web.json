{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/renderer/**/*.json",
    "src/renderer/**/*.d.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.vue",
    "src/shared/**/*"
  ],
  "exclude": ["src/renderer/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "#icons": ["./src/renderer/src/lib/icons/free.ts"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
