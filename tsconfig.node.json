{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "src/main/**/*",
    "src/engine/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/**/*.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}
