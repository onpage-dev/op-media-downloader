{
  "name": "op-media-downloader",
  "version": "2.0.0",
  "description": "Keeps a local or network folder in sync with the media files of an On Page project",
  "main": "./out/main/index.js",
  "author": "On Page®",
  "homepage": "https://app.onpage.it/#/",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn run typecheck:node && yarn run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "yarn run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "yarn run build && electron-builder --win --config",
    "build:mac": "yarn run build && electron-builder --mac --config --$ARCH",
    "notarize": "node ./build/notarize.js",
    "build:mac-with-notarize": "yarn build:mac && yarn notarize",
    "build:linux": "yarn run build && electron-builder --linux --config",
    "translate": "node ./bin/translate.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "onpage-js": "^1.2.0"
  },
  "devDependencies": {
    "@awesome.me/kit-6d2a188266": "^1.0.165",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/pro-light-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@rushstack/eslint-patch": "^1.2.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^8.28.0",
    "eslint-plugin-vue": "^9.7.0",
    "flag-icons": "^7.6.0",
    "postcss": "^8.5.32",
    "prettier": "^2.7.1",
    "sass": "^1.107.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-tsc": "^3.3.14"
  }
}
