{
  "name": "op-media-downloader",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Keeps a local or network folder in sync with the media files of an On Page project",
  "author": "On Page®",
  "homepage": "https://app.onpage.it/#/",
  "repository": {
    "type": "git",
    "url": "https://github.com/onpage-dev/op-media-downloader.git"
  },
  "bugs": "https://github.com/onpage-dev/op-media-downloader/issues",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "yarn run typecheck && node scripts/notices.mjs && tauri build",
    "build:renderer": "vite build",
    "tauri": "tauri",
    "typecheck": "yarn run typecheck:node && yarn run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/pro-icons.mjs",
    "app-icons": "node scripts/app-icons.mjs",
    "postinstall": "node scripts/pro-icons.mjs && node scripts/notices.mjs --no-rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "flag-icons": "^7.6.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "yarn@1.22.22"
}
